# Pullwright control plane (`pullwright-serve`). Copy to server/.env and fill in.
# Everything optional is off when unset. Full reference: docs/configuration.md

# --- required ---------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
PULLWRIGHT_SECRET=                      # long random string; signs session cookies and account-link tokens
PULLWRIGHT_PUBLIC_URL=http://localhost:8765

# GitHub: a GitHub App (recommended for an organization; docs/setup-github-app.md) ...
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=            # path to the app's .pem (or GITHUB_APP_PRIVATE_KEY with the PEM itself)
# ... or a personal access token for local development only
# GITHUB_TOKEN=

# Web UI login (a GitHub OAuth app; callback URL: $PULLWRIGHT_PUBLIC_URL/auth/github/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- which repositories, and the queue --------------------------------------------------------
PULLWRIGHT_REPOS=                       # comma-separated owner/name; tasks for other repos are refused
PULLWRIGHT_MAX_PARALLEL=1               # issues implemented at the same time
PULLWRIGHT_POLL_SECONDS=30
PULLWRIGHT_FEEDBACK_QUIET_SECONDS=120   # wait after the newest PR review comment before a follow-up
PULLWRIGHT_FEEDBACK_TRIGGER=any        # any | mention (only comments that mention @pullwright)
PULLWRIGHT_RUNNER=docker                # docker | local (local = no isolation, development only)
PULLWRIGHT_RUNNER_IMAGE=ghcr.io/mystery01092000/pullwright-runner:latest

# --- cost caps (USD) --------------------------------------------------------------------------
PULLWRIGHT_PLAN_MAX_COST_USD=1          # describer + verifier, per plan
PULLWRIGHT_MAX_COST_USD=5               # supervisor + workers + reviewer, per issue
PULLWRIGHT_MAX_ROUNDS=2                 # coder -> checks rounds per issue, then a draft PR for a human
# PULLWRIGHT_CODER=native                 # native | claude-code | goose (docs/coders.md)
# PULLWRIGHT_CODER_BY_REPO={"acme/api": "goose"}
# PULLWRIGHT_RUNNER_CACHE=pullwright-cache   # shared package caches for runners; empty turns it off

# --- Slack (Socket Mode; docs/setup-slack.md) -------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
PULLWRIGHT_SLACK_REPOS=                 # optional JSON: {"C0123ABC": "arcane/app"} default repo per channel

# --- Microsoft Teams (docs/setup-teams.md) ----------------------------------------------------
PULLWRIGHT_TEAMS_APP_ID=
PULLWRIGHT_TEAMS_APP_PASSWORD=
PULLWRIGHT_TEAMS_TENANT_ID=             # single-tenant bots
PULLWRIGHT_TEAMS_REPOS=                 # optional JSON: {"19:...@thread.tacv2": "arcane/app"}

# --- models and providers (docs/providers.md) ------------------------------------------------
# Any role can run on any provider: provider:model, e.g. openai:<model>, gemini:<model>, ollama:<model>
# PULLWRIGHT_MAIN_MODEL=claude-sonnet-5-5
# PULLWRIGHT_WORKER_MODEL=claude-haiku-5-5
# PULLWRIGHT_MODEL_VERIFIER=          # one role (describer, verifier, supervisor, worker, diagnosis, ...)
# OPENAI_API_KEY=  GEMINI_API_KEY=  OPENROUTER_API_KEY=  GROQ_API_KEY=  DEEPSEEK_API_KEY=  MISTRAL_API_KEY=
# PULLWRIGHT_PROVIDERS=               # JSON or a file: custom providers and prices
# PULLWRIGHT_PRICES=                  # JSON or a file: prices for non-Anthropic models
# PULLWRIGHT_LLM_PROXY_URL=           # e.g. http://host.docker.internal:8765/llm: runners get a job token, never a key

# --- organisation config: shared agents, skills, hooks (docs/org-config.md) --------------------
# PULLWRIGHT_ORG_CONFIG=acme/agent-config@v1        # owner/repo[@ref][:folder], any account; install the GitHub App there,
# PULLWRIGHT_ORG_CONFIG_READ_TOKEN=                 # ...or a fine-grained token: that one repository, Contents read-only

# --- storage ----------------------------------------------------------------------------------
PULLWRIGHT_DB=pullwright.db              # or postgresql://user:pass@host:5432/pullwright (postgres extra)
PULLWRIGHT_WORKDIR=.pullwright-work     # cached read-only clones for planning
